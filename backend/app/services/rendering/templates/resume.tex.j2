\documentclass[letterpaper,10pt]{article}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage[margin=0.2in]{geometry}
\usepackage{titlesec}
\titleformat{\section}{\normalsize\bfseries}{}{0em}{}[\titlerule]
\titlespacing*{\section}{0pt}{8pt plus 2pt minus 2pt}{4pt}
\setlist[itemize]{leftmargin=*, itemsep=4pt, topsep=2pt}
\hypersetup{colorlinks=true, urlcolor=blue, pdfnewwindow=true}
\pagestyle{empty}
\begin{document}
\begin{center}
    {\LARGE \textbf{ {{- content.basics.name -}} }} \\[4pt]
{%- if content.basics.location %}
    {{ content.basics.location }} \\[4pt]
{%- endif %}
{%- set contact_parts = [] -%}
{%- if content.basics.phone -%}
    {{- contact_parts.append(content.basics.phone) or "" -}}
{%- endif -%}
{%- if content.basics.email -%}
    {{- contact_parts.append('\href{mailto:' + content.basics.email + '}{' + content.basics.email + '}') or "" -}}
{%- endif -%}
{%- for profile in content.basics.profiles -%}
    {{- contact_parts.append('\href{' + profile.url + '}{' + (profile.username or profile.network) + '}') or "" -}}
{%- endfor -%}
{%- if contact_parts %}
    {{ contact_parts | join(' $|$ ') }} \\[4pt]
{%- endif %}
{%- if content.basics.summary %}
    {{ content.basics.summary }}
{%- endif %}
\end{center}
{% for section in content.sections %}
\section*{ {{- section.label -}} }
{%- if section.skill_rows %}
{%- for sk in section.skill_rows %}
\textbf{ {{- sk.category -}} :} {{ sk.items }} \\
{%- endfor %}
{%- endif %}
{%- if section.entries %}
{%- for entry in section.entries %}
\textbf{ {{- entry.title -}} } \hfill \textbf{ {{- entry.dates or '' -}} }
{%- if entry.role %}
\textit{ {{- entry.role -}} }{%- if entry.location %} \hfill \textit{ {{- entry.location -}} }{%- endif %}
{%- endif %}
{%- if entry.organization %}
{{ entry.organization }}
{%- endif %}
{%- if entry.url %}
\href{ {{- entry.url -}} }{ {{- entry.url -}} }
{%- endif %}
{%- if entry.bullets %}
\begin{itemize}[itemsep=-2pt]
{%- for bullet in entry.bullets %}
    \item {{ bullet.text | span_format(bullet.spans) }}
{%- endfor %}
\end{itemize}
{%- endif %}
{%- endfor %}
{%- endif %}
{% endfor %}
\end{document}
